{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Balance",
  "version": "0.3.0",
  "identifier": "com.balance.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default", "updater-loopback"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "externalBin": ["binaries/balance-node"],
    "resources": {
      "../.output": "balance-server",
      "resources/sidecar-watchdog.cjs": "sidecar-watchdog.cjs",
      "resources/node/LICENSE": "licenses/node/LICENSE",
      "../scripts/balance-claude-statusline.mjs": "claude-statusline.mjs"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QUFDRTYyM0E0QkIxREMKUldUY3NVczZZczZxTlE1M1Q0TFZsZ25teFY1a3hhQU9tQWc3QzhLdGYvVmU3STd4Q2RsVUZkaFcK",
      "endpoints": [
        "https://github.com/stakeswky/Balance/releases/latest/download/latest.json"
      ]
    }
  }
}
